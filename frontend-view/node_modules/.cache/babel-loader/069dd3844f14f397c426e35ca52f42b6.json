AACA,YAAA;AACA,cAAA,GAAA,GAAA,CAAA,OAAA,CAAA,EAAA,CAAA;AACA,gBAAA,QAAA,GAAA,MAAA,KAAA,MAAA,CAAA,IAAA,CAAA,sBAAA,EAAA,GAAA,CAAA;;AACA,cAAA,QAAA,CAAA,IAAA,CAAA,IAAA,KAAA,GAAA,EAAA;AACA,iBAAA,OAAA,CAAA;AACA,cAAA,QAAA,EAAA,IADA;AAEA,cAAA,KAAA,EAAA,kBAFA;AAGA,cAAA,OAAA,EAAA,SAHA;AAIA,cAAA,IAAA,EAAA;AAJA,aAAA;AAMA,iBAAA,cAAA;AACA;AACA;AACA,SAbA,CAaA,OAAA,KAAA,EAAA;AACA,eAAA,OAAA,CAAA,KAAA,CAAA;AACA,YAAA,QAAA,EAAA,IADA;AAEA,YAAA,KAAA,EAAA,OAFA;AAGA,YAAA,OAAA,EAAA;AAHA,WAAA;AAKA,UAAA,OAAA,CAAA,KAAA,CAAA,QAAA,EAAA,KAAA;AACA;AACA;AACA,KApCA;;AAqCA,IAAA,WAAA,CAAA,OAAA,EAAA;AACA,MAAA,cAAA,CAAA,OAAA,CAAA,WAAA,EAAA,OAAA,CAAA,EAAA;AACA,WAAA,OAAA,CAAA,IAAA,CAAA,gBAAA,EAFA,CAEA;AACA,KAxCA;;AAyCA,IAAA,WAAA,CAAA,GAAA,EAAA,KAAA,EAAA;AACA,MAAA,OAAA,CAAA,GAAA,CAAA,GAAA,EAAA,KAAA;AACA,KA3CA;;AA4CA,IAAA,cAAA,GAAA;AACA,WAAA,MAAA,CAAA,GAAA,CAAA,oBAAA,EAAA,IAAA,CAAA,GAAA,IAAA;AACA,cAAA;AAAA,UAAA;AAAA,YAAA,GAAA;;AACA,YAAA,IAAA,CAAA,IAAA,KAAA,GAAA,EAAA;AACA,eAAA,WAAA,GAAA,IAAA,CAAA,IAAA;AACA;AACA,OALA,EAKA,KALA,CAKA,KAAA,IAAA;AACA,QAAA,OAAA,CAAA,GAAA,CAAA,OAAA,EAAA,KAAA;AACA,OAPA;AAQA,KArDA;;AAsDA,IAAA,WAAA,GAAA;AACA,WAAA,MAAA,CAAA,GAAA,CAAA,cAAA,EAAA,IAAA,CAAA,GAAA,IAAA;AACA,cAAA;AAAA,UAAA;AAAA,YAAA,GAAA;;AACA,YAAA,IAAA,CAAA,IAAA,KAAA,GAAA,EAAA;AACA,eAAA,IAAA,GAAA,IAAA,CAAA,IAAA;AACA;AACA,OALA,EAKA,KALA,CAKA,KAAA,IAAA;AACA,QAAA,OAAA,CAAA,GAAA,CAAA,OAAA,EAAA,KAAA;AACA,OAPA;AAQA;;AA/DA;AAbA,CAAA","sourcesContent":["<template>\r\n    <!-- Dashboard Page -->\r\n    <div class=\"text\">\r\n        <el-row style=\"background-color: rgb(255,255,255); padding: 20px\">\r\n            <el-col :span=\"24\">\r\n                <div class=\"info\">\r\n                    <div>\r\n                        <img :src=\"info.userAvatar\" alt=\"\">\r\n                    </div>\r\n                    <div>\r\n                        <div class=\"title\">{{ info.userName }}</div>\r\n                        <div class=\"point-info\">\r\n                            <span>Views: {{ info.viewCount }}</span>\r\n                            <span>Likes: {{ info.upvoteCount }}</span>\r\n                            <span>Saves: {{ info.saveCount }}</span>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div style=\"margin-inline: 20px;\">\r\n                    <el-tabs v-model=\"activeName\" @tab-click=\"handleClick\">\r\n                        <el-tab-pane label=\"Gourmet\" name=\"first\">\r\n                            <div class=\"item-gourmet\" v-for=\"(gourmet, index) in gourmetList\" :key=\"index\">\r\n                                <div class=\"left\">\r\n                                    <img :src=\"gourmet.cover\">\r\n                                </div>\r\n                                <div class=\"right\">\r\n                                    <div class=\"info\">\r\n                                        <img style=\"width: 25px; height: 25px; border-radius: 50%;\"\r\n                                            :src=\"gourmet.userAvatar\">\r\n                                        <span>{{ gourmet.userName }}</span>\r\n                                    </div>\r\n                                    <div class=\"title\" @click=\"readGourmet(gourmet)\">\r\n                                        {{ gourmet.title }}\r\n                                    </div>\r\n                                    <div class=\"detail\">\r\n                                        {{ gourmet.detail }}\r\n                                    </div>\r\n                                    <div class=\"detail\">\r\n                                        <span> {{ gourmet.createTime }}</span>\r\n                                        <span> Views({{ gourmet.viewCount }})</span>\r\n                                        <span> Likes({{ gourmet.upvoteCount }})</span>\r\n                                        <span> Saves({{ gourmet.saveCount }})</span>\r\n                                        <span> Rating({{ gourmet.rating }})</span>\r\n                                        <span style=\"color: rgb(0,95,200)\" @click=\"edit(gourmet)\"> Modify </span>\r\n                                        <span style=\"color: rgb(250,95,0)\" @click=\"del(gourmet)\"> Delete </span>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                        </el-tab-pane>\r\n                        <el-tab-pane label=\"Cookbook\" name=\"second\">Cookbook</el-tab-pane>\r\n                    </el-tabs>\r\n                </div>\r\n            </el-col>\r\n        </el-row>\r\n    </div>\r\n</template>\r\n<script>\r\nexport default {\r\n    name: \"Service\",\r\n    data() {\r\n        return {\r\n            info: {},\r\n            activeName: 'first',\r\n            gourmetList: {}\r\n        }\r\n    },\r\n    created() {\r\n        this.fetchCenter();\r\n        this.fetchMyGourmet();\r\n    },\r\n    methods: {\r\n        // 修改gourmet\r\n        edit(gourmet) {\r\n            sessionStorage.setItem('gourmetId',gourmet.id);\r\n            this.$router.push('/editGourmet');\r\n        },\r\n        // 删除gourmet\r\n        async del(gourmet) {\r\n            const confirmed = await this.$swalConfirm({\r\n                title: 'delete confirmation',\r\n                text: `operation unrecoverable, continue？`,\r\n                icon: 'warning',\r\n            });\r\n            if (confirmed) {\r\n                try {\r\n                    let ids = [gourmet.id];\r\n                    const response = await this.$axios.post(`/gourmet/batchDelete`, ids);\r\n                    if (response.data.code === 200) {\r\n                        this.$notify({\r\n                            duration: 1000,\r\n                            title: 'Delete Operation',\r\n                            message: 'success',\r\n                            type: 'success'\r\n                        });\r\n                        this.fetchMyGourmet();\r\n                        return;\r\n                    }\r\n                } catch (error) {\r\n                    this.$notify.error({\r\n                        duration: 1000,\r\n                        title: 'Error',\r\n                        message: error\r\n                    });\r\n                    console.error(`Error：`, error);\r\n                }\r\n            }\r\n        },\r\n        readGourmet(gourmet) {\r\n            sessionStorage.setItem('gourmetId', gourmet.id);\r\n            this.$router.push('/gourmetDetail'); // 跳转到美食做法详情页\r\n        },\r\n        handleClick(tab, event) {\r\n            console.log(tab, event);\r\n        },\r\n        fetchMyGourmet() {\r\n            this.$axios.get(\"/gourmet/queryUser\").then(res => {\r\n                const { data } = res;\r\n                if (data.code === 200) {\r\n                    this.gourmetList = data.data;\r\n                }\r\n            }).catch(error => {\r\n                console.log(\"Error\", error);\r\n            });\r\n        },\r\n        fetchCenter() {\r\n            this.$axios.get(\"/user/center\").then(res => {\r\n                const { data } = res;\r\n                if (data.code === 200) {\r\n                    this.info = data.data;\r\n                }\r\n            }).catch(error => {\r\n                console.log(\"Error\", error);\r\n            });\r\n        }\r\n    }\r\n};\r\n</script>\r\n\r\n<style scoped lang=\"scss\">\r\n.info {\r\n    display: flex;\r\n    justify-content: left;\r\n    padding: 20px;\r\n    gap: 20px;\r\n\r\n    img {\r\n        width: 100px;\r\n        height: 100px;\r\n        border-radius: 50%;\r\n    }\r\n\r\n    .title {\r\n        font-size: 24px;\r\n        font-weight: bold;\r\n        text-align: left;\r\n\r\n    }\r\n\r\n    .point-info {\r\n        margin-top: 10px;\r\n        font-size: 16px;\r\n        color: #666;\r\n        justify-content: left;\r\n\r\n        span {\r\n            margin-right: 20px;\r\n        }\r\n    }\r\n}\r\n\r\n.item-gourmet:hover {\r\n    background-color: rgb(245, 245, 245);\r\n}\r\n\r\n.item-gourmet {\r\n    display: flex;\r\n    justify-content: left;\r\n    gap: 10px;\r\n    padding: 10px;\r\n    border-radius: 5px;\r\n    cursor: pointer;\r\n\r\n    .left {\r\n        img {\r\n            width: 220px;\r\n            border-radius: 5px;\r\n            height: 150px;\r\n        }\r\n\r\n    }\r\n\r\n    .right {\r\n        text-align: left;\r\n\r\n        .title:hover {\r\n            text-decoration: underline;\r\n        }\r\n\r\n        .title {\r\n            padding: 4px 6px;\r\n            font-size: 20px;\r\n            font-weight: bold;\r\n\r\n        }\r\n\r\n        .detail {\r\n            margin-top: 10px;\r\n            padding: 4px 6px;\r\n            font-size: 15px;\r\n            color: #333232;\r\n            display: flex;\r\n            justify-content: left;\r\n            gap: 10px;\r\n        }\r\n\r\n        .info {\r\n            padding: 4px 6px;\r\n            display: flex;\r\n            justify-content: left;\r\n            align-items: center;\r\n            gap: 5px;\r\n            font-size: 15px;\r\n        }\r\n    }\r\n}\r\n</style>\r\n"],"sourceRoot":"src/views/user"}]}