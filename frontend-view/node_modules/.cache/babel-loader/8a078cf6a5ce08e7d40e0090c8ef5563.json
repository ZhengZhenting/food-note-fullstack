A,IAAA,MAAA,CAAA,EAAA,CAAA;AACA,gBAAA,QAAA,GAAA,MAAA,KAAA,MAAA,CAAA,IAAA,CAAA,uBAAA,EAAA,GAAA,CAAA;;AACA,cAAA,QAAA,CAAA,IAAA,CAAA,IAAA,KAAA,GAAA,EAAA;AACA,iBAAA,OAAA,CAAA;AACA,cAAA,QAAA,EAAA,IADA;AAEA,cAAA,KAAA,EAAA,QAFA;AAGA,cAAA,OAAA,EAAA,sBAHA;AAIA,cAAA,IAAA,EAAA;AAJA,aAAA;AAMA,iBAAA,cAAA;AACA;AACA;AACA,SAbA,CAaA,OAAA,KAAA,EAAA;AACA,eAAA,QAAA,CAAA,KAAA,CAAA,QAAA,EAAA,KAAA;AACA,UAAA,OAAA,CAAA,KAAA,CAAA,QAAA,EAAA,KAAA;AACA;AACA;AACA,KArFA;;AAsFA;AACA,UAAA,cAAA,GAAA;AACA,UAAA;AACA;AACA,aAAA,SAAA,GAAA,EAAA;AACA,YAAA,SAAA,GAAA,IAAA;AACA,YAAA,OAAA,GAAA,IAAA;;AACA,YAAA,KAAA,UAAA,IAAA,IAAA,IAAA,KAAA,UAAA,CAAA,MAAA,KAAA,CAAA,EAAA;AACA,gBAAA,CAAA,SAAA,EAAA,OAAA,IAAA,MAAA,OAAA,CAAA,GAAA,CAAA,KAAA,UAAA,CAAA,GAAA,CAAA,IAAA,IAAA,IAAA,CAAA,WAAA,EAAA,CAAA,CAAA;AACA,UAAA,SAAA,GAAA,GAAA,SAAA,CAAA,KAAA,CAAA,GAAA,EAAA,CAAA,CAAA,WAAA;AACA,UAAA,OAAA,GAAA,GAAA,OAAA,CAAA,KAAA,CAAA,GAAA,EAAA,CAAA,CAAA,WAAA;AACA,SATA,CAUA;;;AACA,cAAA,MAAA,GAAA;AACA,UAAA,OAAA,EAAA,KAAA,WADA;AAEA,UAAA,IAAA,EAAA,KAAA,QAFA;AAGA,UAAA,GAAA,EAAA,KAAA,UAHA;AAIA,UAAA,SAAA,EAAA,SAJA;AAKA,UAAA,OAAA,EAAA,OALA;AAMA,aAAA,KAAA;AANA,SAAA;AAQA,cAAA,QAAA,GAAA,MAAA,KAAA,MAAA,CAAA,IAAA,CAAA,iBAAA,EAAA,MAAA,CAAA;AACA,cAAA;AAAA,UAAA;AAAA,YAAA,QAAA;AACA,aAAA,SAAA,GAAA,IAAA,CAAA,IAAA;AACA,aAAA,UAAA,GAAA,IAAA,CAAA,KAAA;AACA,OAvBA,CAuBA,OAAA,KAAA,EAAA;AACA,aAAA,QAAA,CAAA,KAAA,CAAA,QAAA,EAAA,KAAA;AACA,QAAA,OAAA,CAAA,KAAA,CAAA,QAAA,EAAA,KAAA;AACA;AACA,KAnHA;;AAoHA,IAAA,YAAA,GAAA;AACA,WAAA,WAAA,GAAA,CAAA;AACA,WAAA,cAAA;AACA,KAvHA;;AAwHA,IAAA,iBAAA,GAAA;AACA,WAAA,UAAA,GAAA,EAAA;AACA,WAAA,YAAA;AACA,KA3HA;;AA4HA,IAAA,gBAAA,CAAA,GAAA,EAAA;AACA,WAAA,QAAA,GAAA,GAAA;AACA,WAAA,WAAA,GAAA,CAAA;AACA,WAAA,cAAA;AACA,KAhIA;;AAiIA,IAAA,mBAAA,CAAA,GAAA,EAAA;AACA,WAAA,WAAA,GAAA,GAAA;AACA,WAAA,cAAA;AACA,KApIA;;AAqIA,IAAA,UAAA,CAAA,GAAA,EAAA;AACA,WAAA,IAAA,GAAA,GAAA;AACA,WAAA,sBAAA,GAAA,IAAA;AACA,WAAA,WAAA,GAAA,IAAA;AACA,KAzIA;;AA0IA;AACA,IAAA,YAAA,CAAA,GAAA,EAAA;AACA,WAAA,YAAA,CAAA,IAAA,CAAA,GAAA;AACA,WAAA,WAAA;AACA;;AA9IA;AAvBA,CAAA","sourcesContent":["<template>\r\n    <el-row style=\"background-color: #FFFFFF;padding: 5px 0;border-radius: 5px;\">\r\n        <el-row style=\"padding: 10px;margin-left: 5px;\">\r\n            <el-row style=\"display: flex;justify-content: left;gap: 6px;\">\r\n                <span class=\"edit-button\" @click=\"add()\">\r\n                    New Cookbook\r\n                </span>\r\n                <el-select style=\"width: 100px;\" @change=\"fetchFreshData\" size=\"small\"\r\n                    v-model=\"cookbookQueryDto.categoryId\" placeholder=\"category\" clearable>\r\n                    <el-option v-for=\"item in categories\" :key=\"item.id\" :label=\"item.name\" :value=\"item.id\">\r\n                    </el-option>\r\n                </el-select>\r\n                <el-select style=\"width: 100px;\" @change=\"fetchFreshData\" size=\"small\"\r\n                    v-model=\"cookbookQueryDto.isPublish\" placeholder=\"publish Status\" clearable>\r\n                    <el-option v-for=\"item in publishStatuList\" :key=\"item.value\" :label=\"item.label\"\r\n                        :value=\"item.value\">\r\n                    </el-option>\r\n                </el-select>\r\n                <el-date-picker style=\"width: 216px;\" @change=\"fetchFreshData\" size=\"small\" v-model=\"searchTime\"\r\n                    type=\"daterange\" range-separator=\"to\" start-placeholder=\"Start Time\" end-placeholder=\"End Time\">\r\n                </el-date-picker>\r\n                <el-input size=\"small\" style=\"width: 226px;\" v-model=\"cookbookQueryDto.title\" placeholder=\"title\"\r\n                    clearable @clear=\"handleFilterClear\">\r\n                    <el-button slot=\"append\" @click=\"handleFilter\" icon=\"el-icon-search\"></el-button>\r\n                </el-input>\r\n            </el-row>\r\n        </el-row>\r\n        <el-row style=\"margin: 0 22px;border-top: 1px solid rgb(245,245,245);\">\r\n            <el-table :stripe=\"true\" :data=\"tableData\" style=\"width: 100%\">\r\n                <el-table-column prop=\"userAvatar\" width=\"68\" label=\"Avatar\">\r\n                    <template slot-scope=\"scope\">\r\n                        <el-avatar :size=\"25\" :src=\"scope.row.userAvatar\" style=\"margin-top: 10px;\"></el-avatar>\r\n                    </template>\r\n                </el-table-column>\r\n                <el-table-column prop=\"userId\" :sortable=\"true\" label=\"User ID\" min-width=\"88\"></el-table-column>\r\n                <el-table-column prop=\"userName\" label=\"User Name\" min-width=\"98\"></el-table-column>\r\n                <el-table-column prop=\"title\" label=\"Cookbook Name\" mind-width=\"118\"></el-table-column>\r\n                <el-table-column prop=\"id\" :sortable=\"true\" label=\"Cookbook ID\" min-width=\"108\"></el-table-column>\r\n                <el-table-column prop=\"categoryName\" label=\"Category\" min-width=\"98\"></el-table-column>\r\n                <el-table-column prop=\"isPublish\" label=\"publish\" min-width=\"98\">\r\n                    <template slot-scope=\"scope\">\r\n                        <span>{{ scope.row.isPublish ? 'Public' : 'Private' }}</span>\r\n                    </template>\r\n                </el-table-column>\r\n                <el-table-column prop=\"createTime\" label=\"Create Time\" :sortable=\"true\"\r\n                    min-width=\"128\"></el-table-column>\r\n                <el-table-column label=\"Operation\" width=\"110\">\r\n                    <template slot-scope=\"scope\">\r\n                        <span class=\"text-button\" @click=\"handleEdit(scope.row)\">Edit</span>\r\n                        <span class=\"text-button\" @click=\"handleDelete(scope.row)\">Delete</span>\r\n                    </template>\r\n                </el-table-column>\r\n            </el-table>\r\n            <el-pagination style=\"margin:10px 0;float: right;\" @size-change=\"handleSizeChange\"\r\n                @current-change=\"handleCurrentChange\" :current-page=\"currentPage\" :page-sizes=\"[20, 50]\"\r\n                :page-size=\"pageSize\" layout=\"total, sizes, prev, pager, next, jumper\"\r\n                :total=\"totalItems\"></el-pagination>\r\n        </el-row>\r\n        <el-dialog :show-close=\"false\" :visible.sync=\"dialogCookbookOperaion\" width=\"25%\">\r\n            <div style=\"padding:16px 20px;\">\r\n                <p> {{ isOperation ? 'edit cookbook' : 'add cookbook' }}</p>\r\n                <div>\r\n                    <input class=\"dialog-input\" v-model=\"data.title\" placeholder=\"Title\" />\r\n                </div>\r\n                <div>\r\n                    <Editor :receiveContent=\"data.content\" @on-receive=\"onReceive\" />\r\n                </div>\r\n                <div style=\"margin-block: 10px\">\r\n                    <span class=\"dialog-hober\">Category</span>\r\n                    <el-select style=\"width: 100px;\" @change=\"fetchFreshData\" size=\"small\" v-model=\"data.categoryId\"\r\n                        placeholder=\"category\" clearable>\r\n                        <el-option v-for=\"item in categories\" :key=\"item.id\" :label=\"item.name\" :value=\"item.id\">\r\n                        </el-option>\r\n                    </el-select>\r\n                </div>\r\n\r\n            </div>\r\n            <span slot=\"footer\" class=\"dialog-footer\" style=\"margin-top: 10px;\">\r\n                <span class=\"channel-button\" @click=\"cannel()\">\r\n                    cancle\r\n                </span>\r\n                <span v-if=\"!isOperation\" class=\"edit-button\" @click=\"addOperation()\">\r\n                    yes\r\n                </span>\r\n                <span v-else class=\"edit-button\" @click=\"updateOperation()\">\r\n                    confirm\r\n                </span>\r\n            </span>\r\n        </el-dialog>\r\n    </el-row>\r\n</template>\r\n\r\n<script>\r\nimport Editor from \"@/components/Editor\"\r\nexport default {\r\n    components: { Editor },\r\n    data() {\r\n        return {\r\n            data: {},\r\n            filterText: '',\r\n            currentPage: 1,\r\n            pageSize: 20,\r\n            totalItems: 0,\r\n            tableData: [],\r\n            delectedRows: [],\r\n            searchTime: [], // 搜索时间范围\r\n            categories: [], // 分类列表\r\n            dialogCookbookOperaion: false, // 弹窗\r\n            isOperation: false, // 默认新增\r\n            cookbookQueryDto: {}, // 搜索条件\r\n            publishStatuList: [{ value: null, label: 'All' }, { value: 0, label: 'Private' }, { value: 1, label: 'Public' }],\r\n        };\r\n    },\r\n    created() {\r\n        this.fetchFreshData();\r\n        this.fetchFreshCategories();\r\n    },\r\n    methods: {\r\n        cannel() {\r\n            this.data = {};\r\n            this.dialogCookbookOperaion = false;\r\n            this.isOperation = false;\r\n        },\r\n        addOperation() {\r\n            this.$axios.post('/cookbook/backSave', this.data).then(response => {\r\n                if (response.data.code === 200) {\r\n                    this.$notify({\r\n                        duration: 1000,\r\n                        title: 'add new cookbook',\r\n                        message: 'successful',\r\n                        type: 'success'\r\n                    });\r\n                    this.cannel();\r\n                    this.fetchFreshData();\r\n                }\r\n            }).catch(error => {\r\n                console.log('Error:', error);\r\n            });\r\n        },\r\n        updateOperation() {\r\n            this.$axios.put('/cookbook/update', this.data).then(response => {\r\n                if (response.data.code === 200) {\r\n                    this.$notify({\r\n                        duration: 1000,\r\n                        title: 'add new cookbook',\r\n                        message: 'successful',\r\n                        type: 'success'\r\n                    });\r\n                    this.cannel();\r\n                    this.fetchFreshData();\r\n                }\r\n            }).catch(error => {\r\n                console.log('Error:', error);\r\n            });\r\n        },\r\n        onReceive(content) {\r\n            // 接收 Editor 组件传递的内容\r\n            this.data.content = content;\r\n        },\r\n        add() {\r\n            this.dialogCookbookOperaion = true;\r\n        },\r\n        fetchFreshCategories() {\r\n            this.$axios.post('/category/query', {}).then(response => {\r\n                if (response.data.code === 200) {\r\n                    this.categories = response.data.data;\r\n                    this.categories.unshift({ id: null, name: 'All' })\r\n                }\r\n            }).catch(error => {\r\n                console.log('Error:', error);\r\n            });\r\n        },\r\n        // 批量删除数据\r\n        async batchDelete() {\r\n            if (!this.delectedRows.length) {\r\n                this.$message(`未选中任何数据`);\r\n                return;\r\n            }\r\n            const confirmed = await this.$swalConfirm({\r\n                title: 'Detele Confirmation',\r\n                text: `Cotent unrecoverable, continue？`,\r\n                icon: 'warning',\r\n            });\r\n            if (confirmed) {\r\n                try {\r\n                    let ids = this.delectedRows.map(entity => entity.id);\r\n                    const response = await this.$axios.post(`/cookbook/batchDelete`, ids);\r\n                    if (response.data.code === 200) {\r\n                        this.$notify({\r\n                            duration: 1000,\r\n                            title: 'delete',\r\n                            message: 'Deleted successfully',\r\n                            type: 'success'\r\n                        });\r\n                        this.fetchFreshData();\r\n                        return;\r\n                    }\r\n                } catch (error) {\r\n                    this.$message.error(\"Error：\", error);\r\n                    console.error(`Error：`, error);\r\n                }\r\n            }\r\n        },\r\n        // 信息查询\r\n        async fetchFreshData() {\r\n            try {\r\n                // 请求参数\r\n                this.tableData = [];\r\n                let startTime = null;\r\n                let endTime = null;\r\n                if (this.searchTime != null && this.searchTime.length === 2) {\r\n                    const [startDate, endDate] = await Promise.all(this.searchTime.map(date => date.toISOString()));\r\n                    startTime = `${startDate.split('T')[0]}T00:00:00`;\r\n                    endTime = `${endDate.split('T')[0]}T23:59:59`;\r\n                }\r\n                // 请求参数\r\n                const params = {\r\n                    current: this.currentPage,\r\n                    size: this.pageSize,\r\n                    key: this.filterText,\r\n                    startTime: startTime,\r\n                    endTime: endTime,\r\n                    ...this.cookbookQueryDto\r\n                };\r\n                const response = await this.$axios.post('/cookbook/query', params);\r\n                const { data } = response;\r\n                this.tableData = data.data;\r\n                this.totalItems = data.total;\r\n            } catch (error) {\r\n                this.$message.error(\"Error:\", error);\r\n                console.error('Error:', error);\r\n            }\r\n        },\r\n        handleFilter() {\r\n            this.currentPage = 1;\r\n            this.fetchFreshData();\r\n        },\r\n        handleFilterClear() {\r\n            this.filterText = '';\r\n            this.handleFilter();\r\n        },\r\n        handleSizeChange(val) {\r\n            this.pageSize = val;\r\n            this.currentPage = 1;\r\n            this.fetchFreshData();\r\n        },\r\n        handleCurrentChange(val) {\r\n            this.currentPage = val;\r\n            this.fetchFreshData();\r\n        },\r\n        handleEdit(row) {\r\n            this.data = row;\r\n            this.dialogCookbookOperaion = true;\r\n            this.isOperation = true;\r\n        },\r\n        // 修改按钮删除事件 \r\n        handleDelete(row) {\r\n            this.delectedRows.push(row);\r\n            this.batchDelete();\r\n        }\r\n    },\r\n};\r\n</script>\r\n<style scoped lang=\"scss\"></style>"],"sourceRoot":"src/views/admin"}]}